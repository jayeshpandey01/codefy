{
  "name": "@whoami/ui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/whoami-ui.js",
  "module": "./dist/whoami-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/whoami-ui.js"
    },
    "./styles.css": "./dist/whoami-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b ./tsconfig.json && vite build",
    "build:types": "tsc -b ./tsconfig.json",
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint src",
    "type-check": "tsc -b ./tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vercel/error": "catalog:",
    "@whoami/types": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.12.0",
    "cytoscape": "^3.30.4",
    "marked": "^15.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/cytoscape": "^3.21.9",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^25.0.1",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
