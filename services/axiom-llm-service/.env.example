# ==========================================
# Axiom LLM Service Environment Configuration
# ==========================================

# 1. Hugging Face Access Token (Required for official meta-llama gated models)
# Get yours for free at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# 2. Model Repository and Filename
# Official Meta Llama 3.2 1B repository (requires HF_TOKEN)
MODEL_REPO=meta-llama/Llama-3.2-1B
MODEL_FILE=

# Alternative: To use pre-quantized GGUF directly:
# MODEL_REPO=bartowski/Llama-3.2-1B-Instruct-GGUF
# MODEL_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
N_THREADS=2
N_CTX=4096

# 4. Security API Key (Optional: require this key on client requests)
API_KEY=axm_live_custom_secret_key_12345
