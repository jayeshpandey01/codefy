{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Codefy Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "build-extension",
      "timeout": 30000
    },
    {
      "name": "Run Codefy (No Debugger)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "build-extension"
    }
  ]
}
