# ==============================================================================
# WhoAmI Security Platform & Scan Orchestrator Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Triage & Patch Generation (Testing phase wiring)
# ------------------------------------------------------------------------------
# Unset (default): packages/core binds ILlmTriageProvider to DeterministicOnlyProvider
# (fully offline, zero token cost, ambiguous sanitizer cases stay `needs-verification`).
# Set: packages/core binds OpenRouterTriageProvider for AI sanitizer classification and git diff patch generation.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Authorized Scan Orchestrator (Dynamic Scanning: HTTPX, Nuclei, Nmap, FFUF)
# ------------------------------------------------------------------------------
# Base URL for the Authorized Scan Orchestrator backend service
ORCHESTRATOR_URL=https://axiom-xjkc.onrender.com

# Operator API Key (Used to submit scans and fetch results)
API_KEY=

# Admin API Key (Used to register scan targets and inspect audit events)
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 3. Axiom Observability & Telemetry (Optional)
# ------------------------------------------------------------------------------
# AXIOM_TOKEN=
# AXIOM_DATASET=
