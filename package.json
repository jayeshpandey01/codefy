{
  "name": "whoami-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "version:sync": "node scripts/sync-version.mjs",
    "desktop:dev": "pnpm --filter @whoami/desktop-app tauri dev",
    "desktop:build": "pnpm --filter @whoami/desktop-app tauri build"
  },
  "devDependencies": {
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  }
}
