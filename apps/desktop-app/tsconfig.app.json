{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "outDir": "dist/types-app",
    "rootDir": "src",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
